@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Contato";
}

@model ExcluirContatoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      method="post">
    <input type="hidden" asp-for="Id" />

    <p class="text-secondary mb-3">Tem certeza de que deseja excluir o contato abaixo?</p>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" disabled readonly>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-semibold text-primary text-uppercase small">E-mail</label>
        <input asp-for="Email" type="email" class="form-control" disabled readonly>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label fw-semibold text-primary text-uppercase small">Telefone</label>
        <input asp-for="Telefone" type="tel" class="form-control" disabled readonly>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Cargo" class="form-label fw-semibold text-primary text-uppercase small">Cargo</label>
            <input asp-for="Cargo" type="text" class="form-control" disabled readonly>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Empresa" class="form-label fw-semibold text-primary text-uppercase small">Empresa</label>
            <input asp-for="Empresa" type="text" class="form-control" disabled readonly>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar Exclusão</button>
    </div>
</form>
