@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Contatos";
}

@model List<ContatoDto>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhum contato cadastrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">
        @foreach (ContatoDto c in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <h5 class="card-title mb-0">@c.Nome</h5>
                            <span class="badge text-bg-primary rounded-pill">@c.Id.ToString("N")[..8]</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(c.Cargo) || !string.IsNullOrWhiteSpace(c.Empresa))
                        {
                            <h6 class="card-subtitle text-body-secondary mb-3">
                                @(string.IsNullOrWhiteSpace(c.Cargo) ? c.Empresa : $"{c.Cargo}{(string.IsNullOrWhiteSpace(c.Empresa)
                    ? "" : $" em {c.Empresa}")}")
                            </h6>
                        }

                        <div class="mb-3">
                            <small class="d-block text-body-secondary">
                                <strong>E-mail:</strong> @c.Email
                            </small>
                            <small class="d-block text-body-secondary">
                                <strong>Telefone:</strong> @c.Telefone
                            </small>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar"
                               asp-route-id="@c.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir"
                               asp-route-id="@c.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
