@{
    Layout = "_Layout";
    ViewBag.Titulo = "Login de usuário";
}

@model LoginUsuarioViewModel;

<form class="card p-4 mx-auto" style="max-width: 480px" asp-controller="Autenticacao" asp-action="Login" method="post">

    <div class="text-danger" asp-validation-summary="All"></div>

    <label class="form-label" asp-for="Email">E-mail</label>
    <input class="form-control mb-3" asp-for="Email" autocomplete="email">

    <label class="form-label" asp-for="Senha">Senha</label>
    <input class="form-control mb-3" asp-for="Senha" type="password" autocomplete="current-password">

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="LembrarMe">
        <label asp-for="LembrarMe">Me manter conectado</label>
    </div>

    <button class="btn btn-primary" type="submit">Entrar</button>
    <a class="mt-3" asp-controller="Autenticacao" asp-action="Cadastro">Criar conta</a>
</form>
